<%= content_for :bare_layout, true %>
<% content_for :title, "Admin Login — Market" %>

<div class="login-page">
  <div class="login-card">
    <h1>Admin Login</h1>

    <%= form_with url: admin_login_path, method: :post, local: true, data: { turbo: false } do |f| %>
      <div class="form-group">
        <%= f.label :email, "Email", class: "form-label" %>
        <%= f.email_field :email, class: "form-input", placeholder: "admin@example.com", required: true, autofocus: true %>
      </div>

      <div class="form-group">
        <%= f.label :password, "Password", class: "form-label" %>
        <%= f.password_field :password, class: "form-input", placeholder: "••••••••", required: true %>
      </div>

      <div class="mt-md">
        <%= f.submit "Sign In", class: "btn btn-primary w-full" %>
      </div>
    <% end %>

    <div class="demo-hint">
      <strong>Demo:</strong> cenius@cenius.ai / cenius
    </div>

    <div style="text-align:center; margin-top: var(--space-md);">
      <%= link_to "← Back to Store", products_path, class: "text-muted", style: "font-size:0.85rem" %>
    </div>
  </div>
</div>
